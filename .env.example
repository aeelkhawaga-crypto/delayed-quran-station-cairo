# URL of the Cairo Quran Radio stream (HLS .m3u8, MP3/AAC shoutcast, or any ffmpeg-supported URL)
STREAM_URL=https://example.com/quran-radio/stream

# Delay between recording and rebroadcast, in seconds.
# 7200 = 2 hours (Cairo is 2h ahead of Ireland most of the year)
DELAY_SECONDS=7200

# Length of each recorded segment in seconds
SEGMENT_SECONDS=10

# How many hours of segments to keep on disk (must exceed DELAY_SECONDS + headroom)
ARCHIVE_HOURS=4

# Audio bitrate for the rebroadcast
BITRATE=128k
